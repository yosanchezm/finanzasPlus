# Patterns are listed twice (x and **/x): unlike .gitignore, a .dockerignore
# pattern without **/ only matches at the root of the build context.
node_modules
**/node_modules
dist
**/dist
dist-nia
**/dist-nia
.env
.env.*
**/.env
**/.env.*
.git
**/.git
*.log
**/*.log

# Not needed to build the web app. scripts/ stays: npm run build runs scripts/check-explain-copy.mjs.
functions
docs
Dockerfile
.dockerignore
